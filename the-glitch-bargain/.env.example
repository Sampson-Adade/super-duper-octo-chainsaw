CLIENT_URL=*
PORT=3001
# Set this when hosting the web app and Socket.IO server separately.
NEXT_PUBLIC_SOCKET_URL=
# Optional; defaults to /socket.io.
NEXT_PUBLIC_SOCKET_PATH=/socket.io
# Optional: enables one structured Responses API adjudication call per round.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
